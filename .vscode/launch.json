{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug in Edge (starts dev server)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev: start (localhost:4200)"
    },
    {
      "name": "Debug in Chrome (starts dev server)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev: start (localhost:4200)"
    }
  ]
}
