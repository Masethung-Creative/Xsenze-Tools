import type { TOC } from '@ember/component/template-only';

/**
 * The Xsenze Tools logo, swapped per theme by CSS (see app.scss .brand-logo):
 *   dark theme  -> /logo.svg        (orange square, dark X)
 *   light theme -> /logo-light.svg  (black square, orange X, orange-outlined "Tools")
 * Both files are generated by `npm run gen-brand`.
 */
const BrandLogo: TOC<{ Args: { size: number }; Element: HTMLSpanElement }> =
  <template>
    <span class="brand-logo" ...attributes>
      <img
        class="brand-logo__dark"
        src="/logo.svg"
        alt=""
        width={{@size}}
        height={{@size}}
      />
      <img
        class="brand-logo__light"
        src="/logo-light.svg"
        alt=""
        width={{@size}}
        height={{@size}}
      />
    </span>
  </template>;

export default BrandLogo;
